// Ezly data model — see docs/TECHNICAL_SPEC.md §4.
// Every business table carries agencyId for tenant isolation.

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  PRODUCER
  CSR
  READ_ONLY
}

enum Lob {
  AUTO
  HOME
  DWELLING_FIRE
}

enum LeadStatus {
  NEW
  CONTACTED
  QUOTED
  SOLD
  LOST
}

enum ApplicationStatus {
  DRAFT
  VALID
  INVALID
}

enum PolicyStatus {
  QUOTED
  BOUND
  ACTIVE
  RENEWING
  CANCELLED
  EXPIRED
  NON_RENEWED
}

model Agency {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  users     User[]
  carriers  Carrier[]
  accounts  Account[]
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  agencyId          String    @db.Uuid
  agency            Agency    @relation(fields: [agencyId], references: [id])
  email             String    @unique
  name              String
  role              Role      @default(CSR)
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  producedAccounts  Account[] @relation("producer")
  servicedAccounts  Account[] @relation("csr")

  @@index([agencyId])
}

model Carrier {
  id              String   @id @default(uuid()) @db.Uuid
  agencyId        String   @db.Uuid
  agency          Agency   @relation(fields: [agencyId], references: [id])
  name            String
  naic            String?
  adapterKey      String // which RatingAdapter quotes this carrier
  appointedStates String[]
  enabled         Boolean  @default(true)
  policies        Policy[]

  @@unique([agencyId, adapterKey])
}

model Account {
  id            String        @id @default(uuid()) @db.Uuid
  agencyId      String        @db.Uuid
  agency        Agency        @relation(fields: [agencyId], references: [id])
  type          String        @default("personal") // personal | commercial
  vip           Boolean       @default(false)
  labels        String[]
  customerSince DateTime?     @db.Date
  producerId    String?       @db.Uuid
  producer      User?         @relation("producer", fields: [producerId], references: [id])
  csrId         String?       @db.Uuid
  csr           User?         @relation("csr", fields: [csrId], references: [id])
  leadSource    String?
  leadStatus    LeadStatus    @default(NEW)
  leadPriority  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  people        Person[]
  addresses     Address[]
  phones        Phone[]
  emails        Email[]
  applications  Application[]
  policies      Policy[]

  @@index([agencyId, leadStatus])
}

model Person {
  id                String    @id @default(uuid()) @db.Uuid
  agencyId          String    @db.Uuid
  accountId         String    @db.Uuid
  account           Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  relationship      String    @default("primary") // primary | spouse | child | other
  prefix            String?
  firstName         String
  middleInitial     String?
  lastName          String
  suffix            String?
  nickname          String?
  gender            String?
  dateOfBirth       DateTime? @db.Date
  maritalStatus     String?
  ssnEncrypted      String? // AES-256-GCM ciphertext, never plain text
  dlNumberEncrypted String?
  dlStatus          String?
  dlState           String?
  education         String?
  industry          String?
  occupation        String?
  preferredLanguage String    @default("English")

  @@index([agencyId, lastName, firstName])
}

model Address {
  id           String  @id @default(uuid()) @db.Uuid
  agencyId     String  @db.Uuid
  accountId    String  @db.Uuid
  account      Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind         String  @default("home") // home | mailing | previous
  line1        String
  line2        String?
  unit         String?
  city         String
  county       String?
  state        String  @db.Char(2)
  zip          String
  zip4         String?
  yearsAt      Int?
  monthsAt     Int?
  isPrimary    Boolean @default(false)

  @@index([agencyId, zip])
}

model Phone {
  id        String  @id @default(uuid()) @db.Uuid
  agencyId  String  @db.Uuid
  accountId String  @db.Uuid
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind      String  @default("mobile")
  number    String

  @@index([agencyId, number])
}

model Email {
  id        String  @id @default(uuid()) @db.Uuid
  agencyId  String  @db.Uuid
  accountId String  @db.Uuid
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind      String  @default("primary")
  address   String

  @@index([agencyId, address])
}

model Application {
  id        String            @id @default(uuid()) @db.Uuid
  agencyId  String            @db.Uuid
  accountId String            @db.Uuid
  account   Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  lob       Lob
  status    ApplicationStatus @default(DRAFT)
  risk      Json // LOB-specific data: drivers, vehicles, dwelling, coverages
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  quoteRuns QuoteRun[]
}

model QuoteRun {
  id            String         @id @default(uuid()) @db.Uuid
  agencyId      String         @db.Uuid
  applicationId String         @db.Uuid
  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  payPlan       String         @default("full_pay")
  submittedAt   DateTime       @default(now())
  quotes        CarrierQuote[]
}

model CarrierQuote {
  id            String   @id @default(uuid()) @db.Uuid
  agencyId      String   @db.Uuid
  quoteRunId    String   @db.Uuid
  quoteRun      QuoteRun @relation(fields: [quoteRunId], references: [id], onDelete: Cascade)
  carrierKey    String
  status        String // ok | error
  annualPremium Decimal? @db.Decimal(12, 2)
  termMonths    Int?
  errors        String[]
  policies      Policy[]
}

model Policy {
  id                String        @id @default(uuid()) @db.Uuid
  agencyId          String        @db.Uuid
  accountId         String        @db.Uuid
  account           Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  carrierId         String        @db.Uuid
  carrier           Carrier       @relation(fields: [carrierId], references: [id])
  sourceQuoteId     String?       @db.Uuid
  sourceQuote       CarrierQuote? @relation(fields: [sourceQuoteId], references: [id])
  lob               Lob
  policyNumber      String?
  status            PolicyStatus  @default(BOUND)
  effectiveDate     DateTime      @db.Date
  expirationDate    DateTime      @db.Date
  writtenPremium    Decimal       @db.Decimal(12, 2)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([agencyId, expirationDate])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  agencyId  String   @db.Uuid
  actorId   String?  @db.Uuid
  entity    String
  entityId  String   @db.Uuid
  action    String
  diff      Json?
  at        DateTime @default(now())

  @@index([agencyId, entity, entityId])
}
