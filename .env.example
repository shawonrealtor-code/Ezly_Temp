# Copy to apps/web/.env and fill in. Never commit real values.
# Private folder for data files. On Hostinger, a folder OUTSIDE public_html.
EZLY_DATA_DIR=../../.data
# 32-byte base64 key for encrypting SSNs and driver's licenses. Generate with: pnpm keygen
EZLY_FIELD_KEY=
# Comma-separated old keys, only while rotating keys.
EZLY_FIELD_KEY_PREVIOUS=
# Sign-in session limits (defaults: 30 minutes idle, 12 hours maximum).
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
# Number of proxies in front of the app that append to X-Forwarded-For (Hostinger: 1).
EZLY_TRUSTED_PROXY_HOPS=1
